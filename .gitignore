# Ignore user upload files
uploads/certificates/*
!uploads/certificates/.gitkeep
uploads/profile_pictures/*
!uploads/profile_pictures/.gitkeep

# Ignore OS files
Thumbs.db
.DS_Store

# Ignore local config overrides / backups
*.bak
*.tmp
skillswap_backup.sql

# Ignore CA certificate (downloaded at runtime)
cacert.pem

# Ignore temp/debug/import scripts
run_import_now.php
import_cloud_db.php
import_cloud_db_tidb.php
make_admin.php
promote_admin.php
test_render_url.php

# Ignore zip archives and PDFs in root
*.zip
*.pdf

# Ignore extracted UML images
uml_extracted/
